# --- ETAPA 1: CONSTRUCCIÓN ---
FROM node:20-alpine AS builder

WORKDIR /app
ENV NX_DAEMON=false

# 1. Instalar dependencias
COPY package.json package-lock.json ./
RUN npm install --legacy-peer-deps

# 2. Copiar archivos base
COPY nx.json tsconfig.base.json ./

# 3. Copiar código fuente
COPY apps ./apps
# COPY libs ./libs (Descomentar si tienes librerías compartidas)

# 4. Construir el frontend
RUN npx nx build web-admin --prod --skip-nx-cache

# --- ETAPA 2: SERVIDOR NGINX ---
FROM nginx:alpine

# 1. Configurar Nginx (Proxy Reverso para conectar con el backend)
# Esto crea la configuración al vuelo
RUN echo 'server { \
    listen 80; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
    location /api/auth/ { \
        proxy_pass http://auth-service:3002/api/auth/; \
        proxy_set_header Host $host; \
    } \
}' > /etc/nginx/conf.d/default.conf

# 2. Copiar los archivos compilados del frontend
# Según tu estructura, Nx guarda en: apps/frontend/web-admin/dist
COPY --from=builder /app/apps/frontend/web-admin/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]