// Configuración única del cliente de Prisma
generator client {
  provider = "prisma-client-js"
}

// Configuración única de la fuente de datos para PostgreSQL
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo de Usuario (Basado en tu ERD)
model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  email         String   @unique
  password_hash String
  role_id       Int
  faculty_id    Int?     // Opcional según el diagrama visual
  role          Role     @relation(fields: [role_id], references: [id])

  @@map("users") // Mapeo a nombre de tabla en minúsculas
}

// Modelo de Rol (Basado en tu ERD)
model Role {
  id          Int      @id @default(autoincrement())
  name        String
  permissions Json     // Para permisos dinámicos en formato JSON
  users       User[]

  @@map("roles")
}

// Entidad para el Academic-Structure-Service
model Faculty {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  careers   Career[]
  
  @@map("faculties")
}

model Career {
  id         Int      @id @default(autoincrement())
  name       String
  faculty_id Int
  faculty    Faculty  @relation(fields: [faculty_id], references: [id])
  courses    Course[]

  @@map("careers")
}

// Entidad para los cursos basada en tu Excel
model Course {
  id               Int      @id @default(autoincrement())
  name             String   // "NombreAsignatura"
  level            String   // "Nivel" (ej: PRIMERO)
  parallel         String   // "Paralelo" (ej: A1-001)
  max_capacity     Int      // "Cupo registrado"
  current_students Int      // "Estudiantes registrados"
  career_id        Int
  career           Career   @relation(fields: [career_id], references: [id])

  @@map("courses")
}

// Entidad para el Rules-Configuration-Service
model BusinessRule {
  id          Int      @id @default(autoincrement())
  rule_name   String   @unique
  value       String   // Ej: "40" para capacidad máxima por aula
  description String?

  @@map("business_rules")
}