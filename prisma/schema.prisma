// Configuración única del cliente de Prisma
generator client {
  provider = "prisma-client-js"
}

// Configuración única de la fuente de datos para PostgreSQL
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo de Usuario (Basado en tu ERD)
model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  email         String   @unique
  password_hash String
  role_id       Int
  faculty_id    Int?     // Opcional según el diagrama visual
  role          Role     @relation(fields: [role_id], references: [id])

  @@map("users") // Mapeo a nombre de tabla en minúsculas
}

// Modelo de Rol (Basado en tu ERD)
model Role {
  id          Int      @id @default(autoincrement())
  name        String
  permissions Json     // Para permisos dinámicos en formato JSON
  users       User[]

  @@map("roles")
}

model Course {
  id          Int      @id @default(autoincrement())
  name        String
  level       String   // Nuevo: Para "PRIMERO", "SEGUNDO", etc.
  section     String   // Nuevo: Para el Paralelo "A1-001"
  max_capacity Int     // Nuevo: El "Cupo registrado" del Excel
  career_id   Int
  career      Career   @relation(fields: [career_id], references: [id])
  
  @@map("courses")
}