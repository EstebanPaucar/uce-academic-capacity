# ==========================================
# CONFIGURACIÓN DE PERSISTENCIA POLÍGLOTA
# ==========================================

# PostgreSQL - Dominio de Estructura Académica y Ciclo de Vida [cite: 155, 278]
DATABASE_URL="postgresql://admin_uce:password_uce@localhost:5432/academic_db?schema=public"
POSTGRES_USER=admin_uce
POSTGRES_PASSWORD=password_uce
POSTGRES_DB=academic_db

# MongoDB - Dominio de Auditoría y Trazabilidad [cite: 156, 280]
MONGO_URI="mongodb://localhost:27017/audit_db"

# Redis - Gestión de Sesiones y Caché de Reglas [cite: 157, 282]
REDIS_HOST=localhost
REDIS_PORT=6379

# ==========================================
# COMUNICACIÓN Y MENSAJERÍA (EVENT-DRIVEN)
# ==========================================

# RabbitMQ - Ingesta Masiva Asíncrona (ETL) [cite: 163, 293]
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Apache Kafka - Bus de Eventos Central [cite: 148, 296]
KAFKA_BROKERS="localhost:9092"

# ==========================================
# SEGURIDAD Y OTROS (IAM)
# ==========================================

# JWT Secret para el auth-service [cite: 122, 176]
JWT_SECRET="UCE_SECRET_KEY_2026_CAMBIAR_EN_PROD"
JWT_EXPIRES_IN="1h"

# n8n - Automatización de Reportes [cite: 168, 253]
N8N_URL="http://localhost:5678"

# Configuración de Seguridad
JWT_SECRET=tu_clave_secreta_super_segura_uce
DATABASE_URL="postgresql://user:password@localhost:5432/uce_db?schema=public"